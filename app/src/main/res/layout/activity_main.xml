<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="① 开启无障碍服务" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="② 开启悬浮窗权限" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="使用说明：\n1. 先按上面顺序开启两个权限。\n2. 回到桌面，会出现一个紫色悬浮球。\n3. 点悬浮球展开面板：\n   ·「翻译整个界面」读取当前屏幕所有文字并翻译；\n   ·「取词模式」开启后，点击屏幕上可点击的文字即可翻译。\n\n注意：本工具通过系统无障碍服务读取文字（非截图识别），翻译结果在悬浮面板中以「原文 → 译文」对照展示。"
        android:textSize="14sp" />
</LinearLayout>
